# --- Database -----------------------------------------------------------
# Local zero-config default (SQLite, file-based, no external account needed):
DATABASE_URL="file:./dev.db"
# For production, switch schema.prisma provider to "postgresql" and use e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dsews?schema=public"

# --- Auth -----------------------------------------------------------------
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="8h"

# --- Server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN="http://localhost:5173"
